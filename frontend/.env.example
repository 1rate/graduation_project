# ============================================
# Tone Call Analyzer — переменные окружения
# ============================================

# Ingest service (загрузка сообщений)
VITE_INGEST_API_URL=http://localhost:8080

# Analytics service (поиск, статистика, детализация)
VITE_ANALYTICS_API_URL=http://localhost:8081

# Режим моков (true = MSW, false = реальный бэкенд)
VITE_USE_MOCKS=true