# Универсальный Dockerfile для Python-сервиса.
# Сборка: docker build --build-arg SERVICE=sentiment -f Dockerfile.python .
#
# Для сервиса stt: --build-arg SERVICE=stt --build-arg INSTALL_FFMPEG=1
# (faster-whisper использует ffmpeg для декодирования mp3/m4a/etc).

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG SERVICE
RUN test -n "$SERVICE" || (echo "SERVICE build-arg is required" && exit 1)

# Опциональный ffmpeg (нужен только stt). Условный apt-get через build-arg.
ARG INSTALL_FFMPEG=0
RUN if [ "$INSTALL_FFMPEG" = "1" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends ffmpeg && \
        rm -rf /var/lib/apt/lists/*; \
    fi

COPY ml/${SERVICE}/requirements.txt ./
RUN pip install -r requirements.txt

COPY ml/${SERVICE}/ ./

ENTRYPOINT ["python", "-u", "main.py"]
