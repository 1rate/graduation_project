# Скопируй в .env и адаптируй под свою машину

# PostgreSQL
POSTGRES_DSN=postgres://diplom:diplom@localhost:5432/diplom?sslmode=disable

# NATS JetStream
NATS_URL=nats://localhost:4222

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=diplom
MINIO_SECRET_KEY=diplomdiplom
MINIO_BUCKET=diplom-audio
MINIO_USE_SSL=false

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=messages

# Авторизация (auth-сервис, ingest, analytics)
JWT_SECRET=dev-insecure-change-me
AUTH_TOKEN_TTL=24h
# admin создаётся/обновляется при старте auth-сервиса
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Категоризация: порог уверенности, ниже которого ставится "без категории"
CATEGORY_MIN_SCORE=0.5

# STT — переключаемый бэкенд
STT_PROVIDER=whisper
STT_WHISPER_URL=http://localhost:9100
STT_YANDEX_API_KEY=
STT_YANDEX_FOLDER_ID=

# ML gRPC сервисы
ML_SENTIMENT_URL=localhost:9101
ML_CATEGORY_URL=localhost:9102

# Логирование
LOG_LEVEL=info
